{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safety-incident-dashboard",
  "account_id": "700978853fa3bc5a00bbb067d5352216",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "safety-incident-dashboard"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safety-incident-dashboard",
      "database_id": "bf7e07c8-4e34-4a4e-b41a-12e5e923e67a",
      "migrations_dir": "migrations"
    }
  ]
}
